<Page x:Class="Lopatkin_Glazki.Glazki_Page"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Lopatkin_Glazki"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Glazki_Page" >

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"></RowDefinition>
            <RowDefinition Height="auto"></RowDefinition>
            <RowDefinition Height="auto"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="auto"></RowDefinition>
        </Grid.RowDefinitions>

        <Button Grid.Row="1" HorizontalAlignment="Right" Width="auto" Content="Добавить абонента" Height="25"  Name="OpenAddEditPage" Click="OpenAddEditPage_Click"></Button>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Grid.Row="0">
            <StackPanel Orientation="Horizontal" Margin="10">
                <TextBlock Text="Введите название для поиска " TextAlignment="Right"
                   Width="240" FontSize="15"></TextBlock>
                <TextBox Name="TBSearch" TextChanged="TBSearch_TextChanged"
                 Width="170" FontSize="15"></TextBox>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="10">
              
                    <ComboBox Name="Sortirovka" SelectionChanged="Sortirovka_SelectionChanged"
                  FontSize="15" Width="140"  IsEditable="True" IsReadOnly="True" Text="Сортировка" LostFocus="Sortirovka_LostFocus" >
                        <TextBlock >Имя по возрастанию</TextBlock>
                        <TextBlock >Имя по убыванию</TextBlock>
                        <TextBlock >Фамилия по возрастанию</TextBlock>
                        <TextBlock >Фамилия по убыванию</TextBlock>
                       
                    </ComboBox>
               

            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="10">
                <ComboBox Name="Filtraciya" SelectionChanged="Filtraciya_SelectionChanged"
                  FontSize="15" Width="140" IsEditable="True"
                    IsReadOnly="True"
                    Text="Фильтрация" >
                    <TextBlock >Основной</TextBlock>
                    <TextBlock >Параллельный</TextBlock>
                    <TextBlock >Спаренный</TextBlock>
                    
                </ComboBox>
            </StackPanel>
        </StackPanel>

 
        <ListView Name="GlazkiListView" Grid.Row="3" Loaded="GlazkiListView_Loaded">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid  Background="{Binding FonStyle}"  >
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition></ColumnDefinition>
                            <ColumnDefinition Width="5"></ColumnDefinition>
                            <ColumnDefinition></ColumnDefinition>
                            <ColumnDefinition></ColumnDefinition>
                            
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="25"/>
                            <RowDefinition Height="25"/>
                            <RowDefinition Height="25"/>
                            <RowDefinition Height="25"/>
                            <RowDefinition Height="20"/>
                            <RowDefinition Height="40"/>
                        </Grid.RowDefinitions>
                        <Image Width="auto" Grid.Column="0"  HorizontalAlignment="Center" Grid.Row="0" Grid.RowSpan="6" >
                            <Image.Source>
                                <Binding Path="Logo">
                                    <Binding.TargetNullValue>
                                        <ImageSource>
                                            Res/picture.png
                                        </ImageSource>
                                    </Binding.TargetNullValue>
                                </Binding>
                            </Image.Source>
                        </Image>
                        <StackPanel Grid.Column="2" Grid.Row="0" Orientation="Horizontal"  Height="30">
                            <TextBlock Grid.Column="1" Grid.Row="0" HorizontalAlignment="Left" FontSize="20" Text="{Binding Фамилия}" TextWrapping="Wrap"></TextBlock>
                            <TextBlock Grid.Column="1" Grid.Row="0" HorizontalAlignment="Left" FontSize="20" Text=" | " TextWrapping="Wrap"></TextBlock>
                            <TextBlock Grid.Column="1" Grid.Row="0" HorizontalAlignment="Left" FontSize="20" Text="{Binding Имя}"></TextBlock>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Grid.Row="1" Orientation="Horizontal">
                            <TextBlock Grid.Column="1" Grid.Row="0" HorizontalAlignment="Left" FontSize="20" Text="Вид телефона "  TextWrapping="NoWrap"  Height="auto"></TextBlock>
                            <TextBlock Grid.Column="1" Grid.Row="0" HorizontalAlignment="Left" FontSize="20" Text="{Binding Вид_телефона}" TextWrapping="NoWrap" ></TextBlock>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Grid.Row="2">
                            <TextBlock Grid.Column="0" Grid.Row="1" HorizontalAlignment="Left" FontSize="16" Text="{Binding Номер_телефона}"></TextBlock>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Grid.Row="3">
                            <TextBlock Grid.Column="0" Grid.Row="1" HorizontalAlignment="Left" FontSize="16" Text="{Binding End_contract}"></TextBlock>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Grid.Row="4" Orientation="Horizontal">
                            <TextBlock Grid.Column="0" Grid.Row="1" HorizontalAlignment="Left" FontSize="16" Text="{Binding Улица}" ></TextBlock>
                            <TextBlock Grid.Column="0" Grid.Row="1" HorizontalAlignment="Left" FontSize="16" Text=" дом "></TextBlock>
                            <TextBlock Grid.Column="0" Grid.Row="1" HorizontalAlignment="Left" FontSize="16" Text="{Binding Дом}"></TextBlock>
                        </StackPanel>

                        <Button Content="Редактирование" Grid.Column="2" Grid.Row="5" HorizontalAlignment="Left" Click="edit"></Button>
                        
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <TextBlock Name="TBcount" FontSize="20" Height="20"></TextBlock>
            <TextBlock Name="TBAllRecords" FontSize="20" Height="20"></TextBlock>

            <Button Name="Left" Content="&lt;" Width="auto" Height="auto"
                    Click="Left_Click"></Button>
            <ListBox FontSize="20" Name="PageListBox" MouseUp="PageListBox_MouseUp">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"></WrapPanel>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
            </ListBox>
            <Button Name="Right" Content="&gt;" Width="auto" Height="auto"
                    Click="Right_Click"></Button>
        </StackPanel>
    </Grid>
</Page>
